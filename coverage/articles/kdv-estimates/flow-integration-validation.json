  "proved": [
    {
      "declaration": "NLS.KdV.IsSmoothPhysicalKdVTrajectory.eq_of_eq_at",
      "result": "Real smooth periodic physical KdV trajectories equal at one time agree at every real time. The PDE yields the exact difference-energy coefficient 6*v_x-3*u_x, bound 18*R, and compact-time Gronwall uniqueness."
    },
    {
      "declaration": "NLS.KdV.isFourierWeakKdVCoefficients_iff",
      "result": "An independently defined continuous-L2, integrated Fourier weak equation is equivalent to its mode derivative identities, with absolutely convergent quadratic convolutions and physical frequency 2*pi*n."
    },
    {
      "declaration": "NLS.KdV.isFourierWeakPhysicalKdV_iff_equation",
      "result": "For profiles differentiable in the continuous-function norm, smooth and periodic in space, the integrated Fourier equation is equivalent to the actual physical differential equation. Reality and continuous first-derivative families give the classical uniqueness regularity class."
    },
    {
      "declaration": "NLS.KdV.isFourierWeakKdVTrajectory_of_locallyUniformLimit",
      "result": "The independent weak equation on the original real physical L2 potential space is closed under locally uniform L2 limits with continuous limit. The proof uses continuity of the L2 bilinear coefficient pairing, compact-time bounds and dominated convergence."
    },
    {
      "declaration": "NLS.KdV.IsKdVSolutionBySmoothPhysicalApproximation.fourierWeak",
      "result": "Actual smooth physical approximation implies the independent integrated Fourier weak equation and the prior classical-approximation conservation solution concept. Both directions are not asserted at low regularity."
    },
    {
      "declaration": "NLS.KdV.IsKdVSolutionByClassicalApproximation.continuous",
      "result": "The previous classical-approximation solution concept implies continuity in the original physical L2 norm."
    },
    {
      "declaration": "NLS.KdV.exists_hillRealWeighted_of_bounded_tendsto",
      "result": "A uniformly bounded sequence in any original real weighted space converging in physical L2 has a limit in that weighted space, with the same bound; limit membership is concluded, not assumed."
    },
    {
      "declaration": "NLS.Articles.KdVEstimates.sobolev_membership_of_convergent_initial_approximation",
      "result": "For m>=1, mean-zero classical H^m approximants with H^m-convergent initial data and physical L2 convergence at each time have a physical limit in H^m at every time, with a uniform-in-time H^m bound. The limit path is not typed in H^m as a premise."
    },
    {
      "declaration": "NLS.KdV.kdvOriginalSobolevHomeomorph",
      "result": "A homeomorphism between the article exact mean-zero real H^m domain and the actual canonical-flow signed Sobolev model, preserving every original Fourier coefficient. Norms are compared with explicit weight inequalities rather than equated."
    },
    {
      "declaration": "NLS.KdV.existsUnique_sobolevKdVSolution",
      "result": "Global existence and uniqueness for every original real mean-zero H^m datum, m>=0, in the nonvacuous universal classical-approximation class. The flow has a group law and jointly continuous time/data dependence in the exact original H^m topology."
    },
    {
      "declaration": "NLS.KdV.roughKdVSolution_has_unique_sobolev_lift",
      "result": "A rough-typed classical-approximation solution whose initial datum lies in the original H^m space has a unique strongly continuous H^m lift for all real times. Higher-space membership and strong continuity are conclusions, not hypotheses on the rough path."
    },
    {
      "declaration": "NLS.KdV.isSobolevKdVSolution_iff_eq_flow",
      "result": "The original H^m solution formulation is equivalent to equality with the constructed actual physical flow; existence of classical approximants and the physical PDE bridge are proved in the imported main-branch construction."
    }
  ],
