import NLS.Articles.KdVPseudomeasures.OriginalHillRoughFrequencyActionFibers
import NLS.SequenceSpaces.FourierRealPhaseFlow
import NLS.SequenceSpaces.OddPositiveFrequency

/-! The global canonical flow generated by the genuine rough KdV
frequencies and the SAME actual native inverse. It preserves the full
original spectrum and is a jointly continuous group in the physical
rough norm. Identification with the physical smooth KdV PDE is separate. -/
noncomputable section
open Set Complex Filter Topology NLS.KdV NLS.WeightedCoeff NLS.LpSequence
namespace NLS.Articles.KdVPseudomeasures

def hillRoughCanonicalKdVFlow (q : HillRealMeanZeroSource) (time : ℝ) : HillRealMeanZeroSource :=
  hillNativeHomeomorph.symm (fourierRealZeroPhaseFlow (Weight.signedSobolev (-1/2))
    (oddPositiveFrequency (fun n => hillRoughKdVFrequency n q))
    (oddPositiveFrequency_neg _) time (hillRealSignedMap q))

theorem hillRoughCanonicalKdVFlow_native (q : HillRealMeanZeroSource) (time : ℝ) :
    hillRealSignedMap (hillRoughCanonicalKdVFlow q time)=
      fourierRealZeroPhaseFlow (Weight.signedSobolev (-1/2))
        (oddPositiveFrequency (fun n => hillRoughKdVFrequency n q))
        (oddPositiveFrequency_neg _) time (hillRealSignedMap q) :=
  hillNativeHomeomorph.apply_symm_apply _

theorem hillRoughCanonicalKdVFlow_positive_coordinate (q : HillRealMeanZeroSource) (time : ℝ) (n : ℕ+) :
    (hillRealSignedMap (hillRoughCanonicalKdVFlow q time)).val.val.val (n:ℤ)=
      exp (((time*hillRoughKdVFrequency n q:ℝ):ℂ)*I)*(hillRealSignedMap q).val.val.val (n:ℤ) := by
  rw [hillRoughCanonicalKdVFlow_native,fourierRealZeroPhaseFlow_apply,oddPositiveFrequency_positive]

theorem hillRoughCanonicalKdVFlow_zero (q : HillRealMeanZeroSource) :
    hillRoughCanonicalKdVFlow q 0=q := by
  apply injective_hillRealSignedMap
  rw [hillRoughCanonicalKdVFlow_native,fourierRealZeroPhaseFlow_zero]

theorem hillRoughCanonicalKdVFlow_products (q : HillRealMeanZeroSource) (time : ℝ) (n : ℕ+) :
    (hillRealSignedMap (hillRoughCanonicalKdVFlow q time)).val.val.val (n:ℤ)*
        (hillRealSignedMap (hillRoughCanonicalKdVFlow q time)).val.val.val (-(n:ℤ))=
      (hillRealSignedMap q).val.val.val (n:ℤ)*(hillRealSignedMap q).val.val.val (-(n:ℤ)) := by
  rw [hillRoughCanonicalKdVFlow_native]
  exact fourierRealZeroPhaseFlow_products _ _ _ _ _ _

theorem hillRoughCanonicalKdVFlow_frequency (q : HillRealMeanZeroSource) (time : ℝ) (n : ℕ+) :
    hillRoughKdVFrequency n (hillRoughCanonicalKdVFlow q time)=hillRoughKdVFrequency n q :=
  hillRoughKdVFrequency_eq_of_native_products n _ q (hillRoughCanonicalKdVFlow_products q time)

theorem hillRoughCanonicalKdVFlow_isospectral (q : HillRealMeanZeroSource) (time : ℝ) :
    originalHillPotentialOfRealSource (hillRoughCanonicalKdVFlow q time) ∈
      originalIsospectralSet (originalHillPotentialOfRealSource q) :=
  originalHillPotentialOfRealSource_isospectral_of_native_products _ q
    (hillRoughCanonicalKdVFlow_products q time)

theorem hillRoughCanonicalKdVFlow_add (q : HillRealMeanZeroSource) (time r : ℝ) :
    hillRoughCanonicalKdVFlow (hillRoughCanonicalKdVFlow q r) time=
      hillRoughCanonicalKdVFlow q (time+r) := by
  apply injective_hillRealSignedMap
  simp only [hillRoughCanonicalKdVFlow_native]
  have hf : (fun n => hillRoughKdVFrequency n (hillRoughCanonicalKdVFlow q r))=
      (fun n => hillRoughKdVFrequency n q) := funext (hillRoughCanonicalKdVFlow_frequency q r)
  rw [hf,fourierRealZeroPhaseFlow_add]

theorem continuous_hillRoughCanonicalKdVFlow :
    Continuous (fun x : ℝ × HillRealMeanZeroSource => hillRoughCanonicalKdVFlow x.2 x.1) := by
  have hf (k : ℤ) : Continuous (fun x : ℝ × HillRealMeanZeroSource =>
      oddPositiveFrequency (fun n => hillRoughKdVFrequency n x.2) k) :=
    continuous_oddPositiveFrequency_family (fun x : ℝ × HillRealMeanZeroSource =>
      fun n => hillRoughKdVFrequency n x.2)
      (fun n => (continuous_hillRoughKdVFrequency n).comp continuous_snd) k
  have ha : Continuous (fun x : ℝ × HillRealMeanZeroSource => hillRealSignedMap x.2) :=
    hillNativeHomeomorph.continuous.comp continuous_snd
  exact hillNativeHomeomorph.symm.continuous.comp
    (continuous_fourierRealZeroPhaseFlow_family (Weight.signedSobolev (-1/2)) (by simp)
      (fun x : ℝ × HillRealMeanZeroSource => oddPositiveFrequency (fun n => hillRoughKdVFrequency n x.2))
      (fun _ => oddPositiveFrequency_neg _) (fun x => x.1) (fun x => hillRealSignedMap x.2)
      hf continuous_fst ha)

end NLS.Articles.KdVPseudomeasures
