import NLS.Fourier.SmoothPeriodicTestLift
import NLS.Fourier.SchwartzMultiplierConvergence

/-! # Smooth periodic tests with the original derivative-norm topology

Tests are actual smooth periodic functions. Their topology is generated by
the sums of sup norms of physical derivatives through each finite order.
The continuity criterion is exactly (A.1), for every positive period.
-/
noncomputable section
open Set Filter Topology
open scoped SchwartzMap ContDiff BoundedContinuousFunction
namespace NLS.Fourier

def smoothPeriodicTestSubmodule (L : ℝ) : Submodule ℂ (ℝ → ℂ) where
  carrier := {f | ContDiff ℝ ∞ f ∧ Function.Periodic f L}
  zero_mem' := ⟨contDiff_const,fun _ => rfl⟩
  add_mem' := fun hf hg => ⟨hf.1.add hg.1,hf.2.add hg.2⟩
  smul_mem' := fun c f hf => ⟨contDiff_const.smul hf.1,fun x => by simp only [Pi.smul_apply,hf.2 x]⟩

def SmoothPeriodicTest (L : ℝ) : Type := ↥(smoothPeriodicTestSubmodule L)
instance (L : ℝ) : AddCommGroup (SmoothPeriodicTest L) := inferInstanceAs (AddCommGroup (smoothPeriodicTestSubmodule L))
instance (L : ℝ) : Module ℂ (SmoothPeriodicTest L) := inferInstanceAs (Module ℂ (smoothPeriodicTestSubmodule L))
instance (L : ℝ) : CoeFun (SmoothPeriodicTest L) (fun _ => ℝ → ℂ) := ⟨fun f => f.1⟩

namespace SmoothPeriodicTest
variable {L : ℝ}
theorem smooth (f : SmoothPeriodicTest L) : ContDiff ℝ ∞ (f : ℝ → ℂ) := f.2.1
theorem periodic (f : SmoothPeriodicTest L) : Function.Periodic (f : ℝ → ℂ) L := f.2.2
@[ext] theorem ext {f g : SmoothPeriodicTest L} (h : ∀ x, f x = g x) : f = g := Subtype.ext (funext h)
@[simp] theorem add_apply (f g : SmoothPeriodicTest L) (x : ℝ) : (f+g) x = f x+g x := rfl
@[simp] theorem smul_apply (c : ℂ) (f : SmoothPeriodicTest L) (x : ℝ) : (c • f) x = c*f x := rfl

theorem smooth_deriv (f : SmoothPeriodicTest L) (k : ℕ) : ContDiff ℝ ∞ (iteratedDeriv k (f : ℝ → ℂ)) := by
  induction k with
  | zero => simpa using f.smooth
  | succ k ih => rw [iteratedDeriv_succ]; exact (contDiff_infty_iff_deriv.mp ih).2

def derivative (hL : L ≠ 0) (k : ℕ) : SmoothPeriodicTest L →ₗ[ℂ] (ℝ →ᵇ ℂ) where
  toFun f :=
    { toFun := iteratedDeriv k (f : ℝ → ℂ)
      continuous_toFun := (f.smooth_deriv k).continuous
      map_bounded' := by
        have hb := (DifferentialPolynomial.periodic_iteratedDeriv (f : ℝ → ℂ) L f.periodic k).isBounded_of_continuous hL (f.smooth_deriv k).continuous
        obtain ⟨C,hC⟩ := isBounded_iff_forall_norm_le.mp hb
        exact ⟨2*C,fun x y => (dist_le_norm_add_norm _ _).trans (by linarith [hC _ ⟨x,rfl⟩,hC _ ⟨y,rfl⟩])⟩ }
  map_add' f g := by
    ext x
    exact iteratedDeriv_add (contDiff_infty.mp f.smooth k).contDiffAt (contDiff_infty.mp g.smooth k).contDiffAt
  map_smul' c f := by
    ext x
    exact iteratedDeriv_const_smul (contDiff_infty.mp f.smooth k).contDiffAt c

@[simp] theorem derivative_apply (hL : L ≠ 0) (k : ℕ) (f : SmoothPeriodicTest L) (x : ℝ) :
    derivative hL k f x = iteratedDeriv k (f : ℝ → ℂ) x := rfl

def cNorm (hL : L ≠ 0) (N : ℕ) : Seminorm ℂ (SmoothPeriodicTest L) :=
  ∑ j ∈ Finset.range (N+1), (normSeminorm ℂ (ℝ →ᵇ ℂ)).comp (derivative hL j)

theorem cNorm_apply (hL : L ≠ 0) (N : ℕ) (f : SmoothPeriodicTest L) :
    cNorm hL N f = ∑ j ∈ Finset.range (N+1), ‖derivative hL j f‖ := by
  simp [cNorm]

instance (L : ℝ) [Fact (0 < L)] : TopologicalSpace (SmoothPeriodicTest L) :=
  (SeminormFamily.moduleFilterBasis (cNorm (Fact.out : 0 < L).ne')).topology

theorem withSeminorms [Fact (0 < L)] : WithSeminorms (cNorm (Fact.out : 0 < L).ne') := ⟨rfl⟩
instance [Fact (0 < L)] : IsTopologicalAddGroup (SmoothPeriodicTest L) := withSeminorms.topologicalAddGroup
instance [Fact (0 < L)] : ContinuousSMul ℂ (SmoothPeriodicTest L) := withSeminorms.continuousSMul

theorem cNorm_mono (hL : L ≠ 0) {N M : ℕ} (h : N ≤ M) (f : SmoothPeriodicTest L) :
    cNorm hL N f ≤ cNorm hL M f := by
  simp only [cNorm_apply]
  exact Finset.sum_le_sum_of_subset_of_nonneg (Finset.range_mono (Nat.add_le_add_right h 1)) (fun _ _ _ => norm_nonneg _)

theorem continuous_iff_finite_order [Fact (0 < L)] (u : SmoothPeriodicTest L →ₗ[ℂ] ℂ) :
    Continuous u ↔ ∃ N : ℕ, ∃ C : ℝ, 0 < C ∧ ∀ f, ‖u f‖ ≤ C*cNorm (Fact.out : 0 < L).ne' N f := by
  constructor
  · intro hu
    obtain ⟨s,C,hC,hb⟩ := Seminorm.bound_of_continuous withSeminorms ((normSeminorm ℂ ℂ).comp u) hu.norm
    refine ⟨s.sup id,C,by exact_mod_cast (pos_iff_ne_zero.mpr hC),fun f => ?_⟩
    have hs : s.sup (cNorm (Fact.out : 0 < L).ne') f ≤ cNorm (Fact.out : 0 < L).ne' (s.sup id) f := by
      apply Seminorm.finset_sup_apply_le (apply_nonneg _ _)
      intro n hn
      exact cNorm_mono _ (Finset.le_sup (f := id) hn) f
    exact (hb f).trans (mul_le_mul_of_nonneg_left hs C.coe_nonneg)
  · rintro ⟨N,C,hC,hb⟩
    apply withSeminorms.continuous_normedSpace_rng ℂ u
    refine ⟨{N},⟨C,hC.le⟩,?_⟩
    simp only [Finset.sup_singleton]
    change ∀ f, ‖u f‖ ≤ C*cNorm (Fact.out : 0 < L).ne' N f
    exact hb

/-- Multiplication by any fixed Schwartz window is continuous for the original test topology. -/
def windowLM (hL : L ≠ 0) (w : 𝓢(ℝ,ℂ)) : SmoothPeriodicTest L →ₗ[ℂ] 𝓢(ℝ,ℂ) where
  toFun f := SchwartzMap.smulLeftCLM ℂ (f : ℝ → ℂ) w
  map_add' f g := by
    ext x
    simp only [SchwartzMap.smulLeftCLM_apply_apply (hasTemperateGrowth_of_smooth_periodic _ L hL (f+g).smooth (f+g).periodic),
      SchwartzMap.smulLeftCLM_apply_apply (hasTemperateGrowth_of_smooth_periodic _ L hL f.smooth f.periodic),
      SchwartzMap.smulLeftCLM_apply_apply (hasTemperateGrowth_of_smooth_periodic _ L hL g.smooth g.periodic),
      add_apply,_root_.add_apply]
    ring
  map_smul' c f := by
    ext x
    simp only [SchwartzMap.smulLeftCLM_apply_apply (hasTemperateGrowth_of_smooth_periodic _ L hL (c • f).smooth (c • f).periodic),
      SchwartzMap.smulLeftCLM_apply_apply (hasTemperateGrowth_of_smooth_periodic _ L hL f.smooth f.periodic),
      smul_apply,_root_.smul_apply,smul_eq_mul,RingHom.id_apply]
    ring

theorem derivative_norm_le_cNorm (hL : L ≠ 0) (f : SmoothPeriodicTest L) {j N : ℕ} (hj : j ≤ N) :
    ‖derivative hL j f‖ ≤ cNorm hL N f := by
  rw [cNorm_apply]
  exact Finset.single_le_sum (f := fun k => ‖derivative hL k f‖) (fun k _ => norm_nonneg _) (Finset.mem_range.mpr (Nat.lt_succ_of_le hj))

theorem window_seminorm_le (hL : L ≠ 0) (w : 𝓢(ℝ,ℂ)) (k n : ℕ) (f : SmoothPeriodicTest L) :
    SchwartzMap.seminorm ℂ k n (windowLM hL w f) ≤ windowSeminormBound k n w*cNorm hL n f := by
  rw [mul_comm]
  apply seminorm_smulLeftCLM_le_of_deriv_le w (hasTemperateGrowth_of_smooth_periodic _ L hL f.smooth f.periodic) k n (apply_nonneg _ _)
  intro j hj x
  exact (BoundedContinuousFunction.norm_coe_le_norm (derivative hL j f) x).trans (derivative_norm_le_cNorm hL f hj)

def windowCLM [Fact (0 < L)] (w : 𝓢(ℝ,ℂ)) : SmoothPeriodicTest L →L[ℂ] 𝓢(ℝ,ℂ) where
  toLinearMap := windowLM (Fact.out : 0 < L).ne' w
  cont := by
    apply withSeminorms.continuous_of_isBounded (schwartz_withSeminorms ℂ ℝ ℂ)
    intro i
    refine ⟨{i.2},⟨windowSeminormBound i.1 i.2 w,windowSeminormBound_nonneg _ _ _⟩,?_⟩
    simp only [Finset.sup_singleton]
    change ∀ f, SchwartzMap.seminorm ℂ i.1 i.2 (windowLM (Fact.out : 0 < L).ne' w f) ≤ windowSeminormBound i.1 i.2 w*cNorm (Fact.out : 0 < L).ne' i.2 f
    exact window_seminorm_le _ w i.1 i.2

end SmoothPeriodicTest
end NLS.Fourier
