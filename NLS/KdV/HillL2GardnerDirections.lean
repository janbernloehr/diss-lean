import NLS.KdV.HillL2GardnerTraceInvolution
import NLS.KdV.HillDirichletDiscriminantBrackets
import NLS.Fourier.ContinuousPeriodOneRealization

/-! # Actual Fourier coefficient directions generated by Hill discriminants

The spatial trace gradient is realized in the original coefficient space
by its actual unit-period Fourier integrals. The resulting tangent has
zero mean and even period-two support. Every actual discriminant has zero
source derivative along it, and actual Dirichlet branch derivatives give
the previously computed normalized Gardner bracket.
-/
noncomputable section
set_option autoImplicit false
open Set Complex Filter Topology MeasureTheory
open NLS.LinearVolterra NLS.ZakharovShabat NLS.ComplexAnalysis NLS.Fourier
namespace NLS.KdV

private theorem spatial_extend_endpoints (q : Coeff 2) (z : ℂ) :
    extend (hillL2TraceGradientSpatialCurve q z) 0=
      extend (hillL2TraceGradientSpatialCurve q z) 1 := by
  exact (extend_coe _ ⟨0,by norm_num⟩).trans
    ((hillL2TraceGradientSpatialCurve_endpoints q z).symm.trans
      (extend_coe _ ⟨1,by norm_num⟩).symm)

/-- Actual unit-period Fourier realization of the spatial trace-gradient direction. -/
def hillL2DiscriminantGardnerDirection (q : Coeff 2) (b : ℂ) : Coeff 2 :=
  Coeff.periodDouble (continuousPeriodOneCoefficients
    (extend (hillL2TraceGradientSpatialCurve q (Complex.sqrt b))) (continuous_extend _)
      (spatial_extend_endpoints q (Complex.sqrt b)))

theorem hillL2DiscriminantGardnerDirection_mem_parity (q : Coeff 2) (b : ℂ) :
    hillL2DiscriminantGardnerDirection q b ∈ Coeff.paritySubspace 0 :=
  Coeff.periodDouble_mem _

/-- The tangent has exactly zero mean in the original coefficient convention. -/
theorem hillL2DiscriminantGardnerDirection_zero (q : Coeff 2) (b : ℂ) :
    hillL2DiscriminantGardnerDirection q b 0=0 := by
  have he := Coeff.periodDouble_even
    (continuousPeriodOneCoefficients
      (extend (hillL2TraceGradientSpatialCurve q (Complex.sqrt b))) (continuous_extend _)
        (spatial_extend_endpoints q (Complex.sqrt b))) (0 : ℤ)
  change hillL2DiscriminantGardnerDirection q b (2*0)=_ at he
  rw [mul_zero] at he
  rw [he,continuousPeriodOneCoefficients_apply]
  change periodOneCoefficient (extend (hillL2TraceGradientSpatialCurve q (Complex.sqrt b))) 0=0
  rw [periodOneCoefficient,← unitFourierCoefficient_eq_fourierCoeffOn,unitFourierCoefficient]
  simp only [mul_zero,neg_zero,wave_zero,mul_one]
  exact integral_hillL2TraceGradientSpatialCurve_eq_zero q (Complex.sqrt b)

/-- Its physical Fourier synthesis is the actual spatial trace gradient. -/
theorem hillL2DiscriminantGardnerDirection_realization (q : Coeff 2) (b : ℂ) :
    circlePullback (l2Synthesis (hillL2DiscriminantGardnerDirection q b))
      =ᵐ[volume.restrict (Ioc (0 : ℝ) 1)]
        extend (hillL2TraceGradientSpatialCurve q (Complex.sqrt b)) :=
  circlePullback_continuousPeriodOneCoefficients _ _ _

/-- The source-to-physical derivative uses precisely that same Fourier direction and sign. -/
theorem hillPhysicalDirection_discriminantGardnerDirection (q : Coeff 2) (b : ℂ) :
    (fun x => -(hillPhysicalDirection (hillL2DiscriminantGardnerDirection q b)).ofLp.2 x)
      =ᵐ[volume.restrict (Ioc (0 : ℝ) 1)]
        extend (hillL2TraceGradientSpatialCurve q (Complex.sqrt b)) := by
  let X := hillL2DiscriminantGardnerDirection q b
  have hr := physicalRestrictionL2_representative (hillFirstOrderDirection X)
  have hn := circle_ae_pullback (Lp.coeFn_neg (l2Synthesis X))
  have hn1 := ae_restrict_of_ae_restrict_of_subset
    (Ioc_subset_Ioc_right (by norm_num : (1 : ℝ)≤2)) hn
  filter_upwards [hr,hn1,hillL2DiscriminantGardnerDirection_realization q b] with x hx hneg hX
  have hs := congrArg Prod.snd hx
  change (hillPhysicalDirection X).ofLp.2 x=circlePullback (l2Synthesis (-X)) x at hs
  change circlePullback (-l2Synthesis X) x= -circlePullback (l2Synthesis X) x at hneg
  change -(hillPhysicalDirection X).ofLp.2 x= _
  rw [hs,map_neg,hneg,neg_neg]
  exact hX

/-- Actual complex potential derivatives of all traces vanish along every trace direction. -/
theorem fderiv_hillL2Discriminant_gardnerDirection_eq_zero (q : Coeff 2) (a b : ℂ) :
    (fderiv ℂ (fun p : Coeff 2 => hillL2Discriminant p a) q)
      (hillL2DiscriminantGardnerDirection q b)=0 := by
  rw [fderiv_hillL2Discriminant_eq_traceGradient_integral]
  have he : (∫ x in (0 : ℝ)..1,
      -(hillPhysicalDirection (hillL2DiscriminantGardnerDirection q b)).ofLp.2 x*
        extend (hillL2TraceGradientCurve q (Complex.sqrt a)) x)=
      ∫ x in (0 : ℝ)..1,extend (hillL2TraceGradientCurve q (Complex.sqrt a)) x*
        extend (hillL2TraceGradientSpatialCurve q (Complex.sqrt b)) x := by
    apply intervalIntegral.integral_congr_ae_restrict
    rw [uIoc_of_le (by norm_num : (0 : ℝ)≤1)]
    filter_upwards [hillPhysicalDirection_discriminantGardnerDirection q b] with x hx
    rw [hx]
    ring
  rw [he]
  exact integral_hillL2TraceGradient_mul_spatial_eq_zero q (Complex.sqrt a) (Complex.sqrt b)

/-- The normalized Gardner bracket is the actual Dirichlet branch source derivative. -/
theorem hillDirichlet_branch_fderiv_discriminantGardnerDirection
    (q : RealPeriodOneHillPotential) (n : ℕ) (hn : 1≤n) (a : Coeff 2 → ℂ)
    (ha : AnalyticAt ℂ a (SpectralWeight.one.toCoeff q.val))
    (ha0 : a (SpectralWeight.one.toCoeff q.val)=
      (hillDirichletEnergy q.val q.property.1 q.property.2 n hn : ℂ))
    (hz : ∀ᶠ p in 𝓝 (SpectralWeight.one.toCoeff q.val), hillL2DirichletCharacteristic p (a p)=0)
    (b : ℂ) :
    (fderiv ℂ a (SpectralWeight.one.toCoeff q.val))
      (hillL2DiscriminantGardnerDirection (SpectralWeight.one.toCoeff q.val) b)=
        hillDirichletDiscriminantGardnerBracket q n hn b := by
  rw [hillDirichletGradient_represents_branch q n hn a ha ha0 hz]
  apply intervalIntegral.integral_congr_ae_restrict
  rw [uIoc_of_le (by norm_num : (0 : ℝ)≤1)]
  filter_upwards [hillPhysicalDirection_discriminantGardnerDirection (SpectralWeight.one.toCoeff q.val) b,
    ae_hasDerivAt_hillL2TraceGradientCurve (SpectralWeight.one.toCoeff q.val) (Complex.sqrt b)] with x hx hd
  rw [hx,hd.deriv]
  ring

end NLS.KdV
