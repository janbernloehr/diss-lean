          throwError "{name} depends transitively on disallowed axiom {ax}"
      checked := checked + 1
  if checked == 0 then
    throwError "The article axiom audit did not run."
  logInfo m!"mKdV/NLS article axiom audit passed for {checked} declarations (including auxiliaries)."
