open Lean in
run_cmd do
  let allowed := #[``propext, ``Classical.choice, ``Quot.sound]
  let modules := #[
    kdvFrequencyAuditChunk0,
    kdvFrequencyAuditChunk1,
    kdvFrequencyAuditChunk2,
    kdvFrequencyAuditChunk3,
    kdvFrequencyAuditChunk4,
    kdvFrequencyAuditChunk5,
    kdvFrequencyAuditChunk6,
    kdvFrequencyAuditChunk7,
    kdvFrequencyAuditChunk8,
    kdvFrequencyAuditChunk9,
    kdvFrequencyAuditChunk10,
    kdvFrequencyAuditChunk11,
    kdvFrequencyAuditChunk12,
    kdvFrequencyAuditChunk13,
    kdvFrequencyAuditChunk14,
    kdvFrequencyAuditChunk15,
    kdvFrequencyAuditChunk16,
    kdvFrequencyAuditChunk17,
    kdvFrequencyAuditChunk18,
    kdvFrequencyAuditChunk19,
    kdvFrequencyAuditChunk20,
    kdvFrequencyAuditChunk21,
    kdvFrequencyAuditChunk22,
    kdvFrequencyAuditChunk23
  ].flatten
  let mut checked : Nat := 0
  let mut candidates : Nat := 0
  let moduleSet : NameSet := modules.foldl (fun names name => names.insert name) {}
  unless modules.all moduleSet.contains && moduleSet.toArray.all modules.contains do
    throwError "The audit module set differs from its exact ordered selection."
  for (name, _) in (← getEnv).constants do
    let candidate := ((← findModuleOf? name).map moduleSet.contains).getD false
    if (`NLS).isPrefixOf name || candidate then
      let axioms ← collectAxioms name
      for ax in axioms do
        unless allowed.contains ax do
          throwError "{name} depends on disallowed axiom {ax}"
      checked := checked + 1
      if candidate then
        candidates := candidates + 1
  if candidates == 0 then
    throwError "No candidate declarations found; the audit did not run."
  logInfo m!"Axiom audit passed: {candidates} candidate declarations; {checked} declarations total."
