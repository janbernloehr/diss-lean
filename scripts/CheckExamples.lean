      (ContinuousLinearMap.fst ℂ ℂ ℂ)) t‖ ≤ classicalGradientDerivativeConstant M H :=
  norm_deriv_classicalEndpointGradientRemainder_sobolev_strip_le M H a ha z hz hH (0,1) (by simp)
    _ (ContinuousLinearMap.norm_fst_le ..) t

