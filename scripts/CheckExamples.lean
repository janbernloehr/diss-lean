    have hp : 0 < |x - y| := lt_of_le_of_ne (abs_nonneg _) (Ne.symm he)
    rw [← Real.rpow_two |x - y|, ← Real.rpow_add hp]
    norm_num
  calc
    _ ≤ ∫⁻ x : ℝ in Set.Ioo 0 2, ∫⁻ y : ℝ in Set.Ioo 0 2, (1 : ℝ≥0∞) := by
      apply MeasureTheory.lintegral_mono
      intro x
      apply MeasureTheory.lintegral_mono
      exact hpoint x
