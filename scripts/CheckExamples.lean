-- The weighted recurrence retains the physical/source cutoff factor.
example (φ : realTypeSourceLocus 3)
    (hfinite : φ ∈ sourceFiniteGapLocus (by simp) (by norm_num))
    (w : SpectralWeight) (ψ : WeightedCoeffPair w.toWeight 3)
