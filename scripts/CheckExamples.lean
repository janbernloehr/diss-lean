example : ∃ ε > 0, ∀ φ : realTypeSourceSubmodule p,
    ‖sourceComplexBirkhoffMap hp hp1 t φ.val‖ < ε →
    ∀ τ : ℝ, (τ,φ) ∈ A.renormalizedImageDomain t :=
