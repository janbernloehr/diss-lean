example (φ : CoeffPair 3) :
    ∃ r : ℝ, 0 < r ∧ ∃ N₀ : ℕ, 2 ≤ N₀ ∧ ∀ N : ℕ, N₀ ≤ N →
      ∀ ψ ∈ Metric.ball φ (4*r), ∀ n : ℤ, N ≤ n.natAbs →
