    ∃ V : Set (CoeffPair (3/2)), IsOpen V ∧ φ.val ∈ V ∧
      ∃ c : ℤ → ℂ, ∃ R : ℤ → ℝ, (∀ k, 0 < R k) ∧
        ∀ ψ ∈ V, ∀ (n k : ℤ) (a : Coeff (3/2)),
          (∀ l : ℕ, sourceAbelianMomentCircle halfFinite oneLtHalf W n k (2*l+1)
