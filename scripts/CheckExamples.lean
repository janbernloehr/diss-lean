  obtain ⟨V,_,_,⟨r,hr,hball⟩,hvalid,_⟩ := A.exists_invariant_small_renormalizedFlow D
  refine ⟨r,hr,fun φ hφ τ => hvalid φ (hball ?_) τ⟩
  simpa only [Metric.mem_ball,dist_zero_right] using hφ

