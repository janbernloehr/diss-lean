  · intro n
    obtain ⟨a,ha,_,_,_⟩ := hoff n
    have h := (lp.memℓp a).summable (by norm_num : 0 < (2:ℝ≥0∞).toReal)
    simpa only [ENNReal.toReal_ofNat,Real.rpow_two,ha] using h
end Four

