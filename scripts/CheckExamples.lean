      (periodOnePotential_mem ψ) n = 0) : A.moment n 3 ψ = 0 ∧ A.moment n 5 ψ = 0 :=
  ⟨A.moment_of_collapsed ψ hψ n hgap 3,A.moment_of_collapsed ψ hψ n hgap 5⟩

end
