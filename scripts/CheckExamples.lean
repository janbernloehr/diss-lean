private theorem d9HalfFinite : (3/2:ℝ≥0∞) ≠ ⊤ := ENNReal.div_ne_top (by norm_num) (by norm_num)
local instance : Fact ((1:ℝ≥0∞) ≤ 3/2) := ⟨d9HalfAboveOne.le⟩

