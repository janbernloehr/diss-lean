namespace PhysicalEnergyChecks
open NLS NLS.ZakharovShabat
open scoped ENNReal
local instance : Fact ((1 : ℝ≥0∞) ≤ 4) := ⟨by norm_num⟩

-- The infinite differentiated action trace has the correct radial mass normalization.
