example (hp2 : p ≤ 2) (φ : realTypeSourceSubmodule p) (τ : ℝ) :
    A.renormalizedImageFlow D φ τ = A.renormalizedSourceFlow D hp2 φ τ :=
  A.renormalizedImageFlow_eq_global D hp2 φ τ

