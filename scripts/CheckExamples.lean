      ((Real.pi:ℂ)*(-2:ℤ)) (Real.pi/4),
      periodicAlgebraicMultiplicity (by simp) (weightedBaseToPair (SpectralWeight.piSobolev 1 (by norm_num)) φ) z) = 2 :=
