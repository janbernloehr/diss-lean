  obtain ⟨T,hT,u,_,_,hd,_,_,hE⟩ := exists_local_smoothNLS_with_conservation f hf hp
  exact ⟨T,hT,u,hd 0 ⟨by linarith,hT⟩,
    (hE (-T) ⟨le_rfl,by linarith⟩).trans (hE T ⟨by linarith,le_rfl⟩).symm⟩

