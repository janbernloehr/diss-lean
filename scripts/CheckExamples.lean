-- The analytic endpoint determinant has order two in the matching parity and zero in the other.
example (r k : ℤ) :
    analyticOrderAt (fun z => (classicalMonodromy 0 z-wave r 1 • 1).det) ((Real.pi : ℂ)*k) =
      (if k % 2 = r % 2 then 2 else 0 : ℕ) := by
