example (w : SpectralWeight)
    (φ : WeightedCoeffPair w.toWeight (ENNReal.ofReal (3/2 : ℝ))) (ε : ℝ) (hε : 0 < ε) :
    ∃ N₀ : ℕ, 2 ≤ N₀ ∧ ∃ U : Set (WeightedCoeffPair w.toWeight (ENNReal.ofReal (3/2 : ℝ))),
      IsOpen U ∧ Convex ℝ U ∧ φ ∈ U ∧ 0 ∈ U ∧
