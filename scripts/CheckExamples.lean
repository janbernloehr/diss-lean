-- The glued curve agrees at a boundary where its choice of interval changes.
example {E : Type*} (v : ℕ → ℝ → E)
    (hc : ∀ m n : ℕ, m ≤ n → EqOn (v m) (v n) (Icc (-exhaustionRadius m) (exhaustionRadius m))) :
